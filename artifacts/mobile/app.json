{
  "expo": {
    "name": "CARNET",
    "slug": "navimed",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "navimed",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2540"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.argilette.navimed",
      "appleTeamId": "Z82KB5AR7N",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "CARNET uses the camera only when you choose to capture a document for a session-only preview.",
        "NSPhotoLibraryUsageDescription": "CARNET accesses your photo library only when you choose a document image for a session-only preview."
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "buildNumber": "35"
    },
    "android": {
      "package": "com.argilette.navimed",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A2540"
      },
      "permissions": [
        "INTERNET",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1a6fbf",
          "sounds": [],
          "defaultChannel": "medication-reminders"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CARNET to use Face ID for quick and secure access to your health records."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b1150c38-8755-4f3f-ba50-59b63e8084b7"
      }
    },
    "owner": "argilette"
  }
}
