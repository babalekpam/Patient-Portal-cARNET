{
  "expo": {
    "name": "CARNET",
    "slug": "navimed",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "navimed",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2540"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.argilette.navimed",
      "appleTeamId": "Z82KB5AR7N",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "CARNET needs access to your camera to scan medical documents, prescriptions, and lab reports for easy upload to your health records.",
        "NSPhotoLibraryUsageDescription": "CARNET needs access to your photo library to upload medical documents, insurance cards, and health-related images to your secure document vault.",
        "NSPhotoLibraryAddUsageDescription": "CARNET needs permission to save medical documents and health records to your photo library."
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "buildNumber": "6"
    },
    "android": {
      "package": "com.argilette.navimed",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A2540"
      },
      "permissions": [
        "INTERNET",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1a6fbf",
          "sounds": [],
          "defaultChannel": "medication-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b1150c38-8755-4f3f-ba50-59b63e8084b7"
      }
    },
    "owner": "argilette"
  }
}
